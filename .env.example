# Copy to .env.local. Keep secrets private.
# Local SQLite is used when BOTH Turso variables are empty. Existing records stay local.
VIERCYS_DB_PATH=data/viercys.sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Explicitly enable the fictional demo for npm run start. Development enables demo automatically.
VIERCYS_DEMO_MODE=true
# Remote/Vercel: private unique 16+ character password, configured via db:init.
# Local only: 12+ characters, or a generated private development credential.
VIERCYS_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_CURRENCY=EUR
APP_URL=http://localhost:3000
# Use onboarding@resend.dev with the sandbox account below, or a verified domain.
# Missing key or sender retains honest preview-only status.
RESEND_API_KEY=
RESEND_FROM="VIERCYS <onboarding@resend.dev>"
# Leave empty to send booking mail to the guest-entered address.
# Optional controlled-inbox override for testing only; see EMAIL_SETUP.md.
RESEND_TEST_RECIPIENT=
RESEND_WEBHOOK_SECRET=
# Optional structured suggestions; blank means deterministic demo fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required only with onboarding@resend.dev: exact Resend account email.
RESEND_SANDBOX_RECIPIENT=
